// Academia Tegra - Schema do banco de dados
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  SUPERVISOR
  CORRETOR
}

model Usuario {
  id            String   @id @default(uuid())
  nome          String
  email         String   @unique
  senhaHash     String
  perfil        Perfil
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  // Somente para CORRETOR
  cpf           String?  @unique
  empresaId     String?
  empresa       EmpresaVenda? @relation(fields: [empresaId], references: [id])
  gerente       String?
  diretor       String?
  creci         String?
  fotoUrl       String?  // chave da foto de perfil (carteirinha), no bucket S3-compatível

  // Relações
  produtosVinculados   ProdutoSupervisor[]      // Somente SUPERVISOR
  treinamentosCriados  Treinamento[]            @relation("TreinamentosCriadosPor")
  interesses           InteresseTreinamento[]
  presencas            Presenca[]
  tentativasProva      TentativaProva[]
  certificados         Certificado[]
  resetTokens          PasswordResetToken[]
  materiaisCriados     MaterialBiblioteca[]

  @@index([perfil])
  @@index([empresaId])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  token      String   @unique
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm   DateTime
  usado      Boolean  @default(false)
  criadoEm   DateTime @default(now())
}

model EmpresaVenda {
  id         String    @id @default(uuid())
  nome       String    @unique
  ativo      Boolean   @default(true)
  criadoEm   DateTime  @default(now())
  corretores Usuario[]
}

model Produto {
  id            String   @id @default(uuid())
  nome          String
  corCalendario String   // hex color, ex: #FF5733
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  certificadosNecessarios Int @default(3) // qtd. de insígnias/Temas Oficiais ativos necessários p/ aptidão

  supervisores   ProdutoSupervisor[]
  treinamentos   Treinamento[]
  provasModelo   ProvaModelo[]
  materiais      MaterialBiblioteca[]
  temasOficiais  TemaOficial[]
}

// Tabela associativa: quais produtos cada supervisor gerencia
model ProdutoSupervisor {
  id           String   @id @default(uuid())
  produtoId    String
  supervisorId String
  produto      Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  supervisor   Usuario  @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([produtoId, supervisorId])
}

// "Treinamento Oficial": cada um representa uma insígnia/vaga de certificado do produto
// (posicao 1, 2, 3...), cadastrado pelo Admin/Supervisor na aba "Produto". Nasce sempre
// com prova. Um treinamento marcado como "obrigatório" na Agenda deve estar vinculado a um
// TemaOficial ativo — isso é o que impede o bug de certificados duplicados: o certificado
// passa a ser identificado pelo ID do TemaOficial (não mais pelo nome digitado), então
// repetir a aplicação do mesmo tema apenas renova a validade em vez de gerar um novo.
// Nunca é excluído de verdade, só inativado (ex: quando certificadosNecessarios diminui),
// para preservar o histórico e permitir reativação futura na mesma posição/insígnia.
model TemaOficial {
  id                String       @id @default(uuid())
  produtoId         String
  produto           Produto      @relation(fields: [produtoId], references: [id])
  posicao           Int          // posição da insígnia na carteirinha (1, 2, 3...)
  ativo             Boolean      @default(true)

  nome              String       // tema/nome oficial do treinamento
  planoTreinamento  String       @db.Text
  provaId           String
  prova             ProvaModelo  @relation(fields: [provaId], references: [id])

  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt

  treinamentos      Treinamento[]
  certificados      Certificado[]

  @@unique([produtoId, posicao])
}

enum StatusTreinamento {
  AGENDADO
  REALIZADO
  CANCELADO
}

model Treinamento {
  id                String    @id @default(uuid())
  produtoId         String
  produto           Produto   @relation(fields: [produtoId], references: [id])
  supervisorId      String
  supervisor        Usuario   @relation("TreinamentosCriadosPor", fields: [supervisorId], references: [id])

  data              DateTime  // data do treinamento
  horario           String    // ex: "14:30"
  tema              String
  localTreinamento  String?
  planoTreinamento  String    @db.Text
  formato           String    @default("PRESENCIAL")
  status            StatusTreinamento @default(AGENDADO)

  temProva          Boolean   @default(true)
  provaId           String?
  prova             ProvaModelo? @relation(fields: [provaId], references: [id])

  // Treinamento obrigatório: vinculado a um Tema Oficial do produto (uma das "insígnias").
  // Quando true, tema/planoTreinamento/provaId são copiados do Tema Oficial e travados —
  // só local/data/horário ficam livres para editar em cada aplicação. É a única origem
  // possível de emissão/renovação de certificado (treinamento livre nunca gera certificado,
  // mesmo com prova e aprovação).
  obrigatorio       Boolean   @default(false)
  temaOficialId     String?
  temaOficial       TemaOficial? @relation(fields: [temaOficialId], references: [id])

  // Controle de liberação da prova (o corretor acessa direto pela tela do treinamento,
  // desde que tenha presença confirmada manualmente pelo supervisor/admin)
  liberadoEm        DateTime?
  liberadoExpiraEm  DateTime? // liberadoEm + 1h

  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  evidencias        Evidencia[]
  interesses        InteresseTreinamento[]
  presencas         Presenca[]
  tentativasProva   TentativaProva[]
  certificados      Certificado[]

  @@index([produtoId])
  @@index([supervisorId])
  @@index([data])
}

model Evidencia {
  id             String      @id @default(uuid())
  treinamentoId  String
  treinamento    Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  urlArquivo     String      // chave/URL no bucket S3-compatível
  nomeArquivo    String
  tipo           String      // image/png, image/jpeg
  enviadoEm      DateTime    @default(now())
}

model InteresseTreinamento {
  id             String      @id @default(uuid())
  treinamentoId  String
  treinamento    Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  corretorId     String
  corretor       Usuario     @relation(fields: [corretorId], references: [id], onDelete: Cascade)
  criadoEm       DateTime    @default(now())
  cancelado      Boolean     @default(false)
  lembreteEnviado Boolean    @default(false)

  @@unique([treinamentoId, corretorId])
}

// Presença confirmada manualmente pelo Supervisor/Admin a partir da lista de interessados
// (vale para treinamentos com ou sem prova)
model Presenca {
  id             String      @id @default(uuid())
  treinamentoId  String
  treinamento    Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  corretorId     String
  corretor       Usuario     @relation(fields: [corretorId], references: [id], onDelete: Cascade)
  confirmadoEm   DateTime    @default(now())

  @@unique([treinamentoId, corretorId])
}

// Modelo de prova reutilizável, vinculado a um produto
model ProvaModelo {
  id           String       @id @default(uuid())
  titulo       String
  produtoId    String
  produto      Produto      @relation(fields: [produtoId], references: [id])
  criadoPorId  String
  criadoEm     DateTime     @default(now())

  questoes     Questao[]
  treinamentos Treinamento[]
  temasOficiais TemaOficial[]
}

model Questao {
  id             String      @id @default(uuid())
  provaModeloId  String
  provaModelo    ProvaModelo @relation(fields: [provaModeloId], references: [id], onDelete: Cascade)
  enunciado      String      @db.Text
  ordem          Int

  alternativas   Alternativa[]
}

model Alternativa {
  id          String   @id @default(uuid())
  questaoId   String
  questao     Questao  @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  texto       String
  correta     Boolean  @default(false)
  ordem       Int
}

enum StatusTentativa {
  EM_ANDAMENTO
  CONCLUIDA
  EXPIRADA
}

model TentativaProva {
  id             String          @id @default(uuid())
  treinamentoId  String
  treinamento    Treinamento     @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  corretorId     String
  corretor       Usuario         @relation(fields: [corretorId], references: [id], onDelete: Cascade)

  iniciadoEm     DateTime        @default(now())
  concluidoEm    DateTime?
  status         StatusTentativa @default(EM_ANDAMENTO)

  acertos        Int?
  totalQuestoes  Int?
  percentual     Float?
  aprovado       Boolean?

  respostas      Resposta[]

  @@unique([treinamentoId, corretorId])
}

model Resposta {
  id               String         @id @default(uuid())
  tentativaId      String
  tentativa        TentativaProva @relation(fields: [tentativaId], references: [id], onDelete: Cascade)
  questaoId        String
  alternativaId    String
}

// Um certificado por (TemaOficial + corretor): renovado (não duplicado) a cada nova
// aprovação no mesmo tema — é isso que resolve o bug de insígnias duplicadas quando o
// mesmo treinamento obrigatório é aplicado mais de uma vez. treinamentoId sempre aponta
// para a aplicação mais recente que gerou/renovou o certificado (histórico "vivo").
//
// temaOficialId é opcional só por segurança de migração: registros antigos (de antes desta
// regra existir, identificados por treinamento em vez de tema oficial) ficam com o campo
// vazio e são ignorados em todos os cálculos de aptidão/carteirinha — são histórico morto,
// mantido apenas para não quebrar o deploy.
model Certificado {
  id             String      @id @default(uuid())
  temaOficialId  String?
  temaOficial    TemaOficial? @relation(fields: [temaOficialId], references: [id])
  treinamentoId  String
  treinamento    Treinamento @relation(fields: [treinamentoId], references: [id])
  corretorId     String
  corretor       Usuario     @relation(fields: [corretorId], references: [id])

  urlArquivo     String      // legado (não é mais gerado PDF); mantido vazio
  percentual     Float
  emitidoEm      DateTime    @default(now())

  @@unique([temaOficialId, corretorId])
}

// Biblioteca de Treinamentos: materiais em PDF/PPT para consulta e download.
// Visível a todos os perfis; cadastro/edição/exclusão restritos a Admin e Supervisor.
model MaterialBiblioteca {
  id                 String   @id @default(uuid())
  produtoId          String
  produto            Produto  @relation(fields: [produtoId], references: [id])
  nome               String
  descricao          String?  @db.Text
  urlArquivo         String   // chave do arquivo no bucket
  nomeArquivo        String
  tipoArquivo        String   // mime type
  tamanhoBytes        Int

  // Se preenchido com o "tema" de um treinamento que gera certificado, o material só fica
  // acessível a corretores com certificado válido daquele treinamento. Se vazio, é público
  // a todos os perfis.
  treinamentoNomeRef String?

  criadoPorId        String
  criadoPor          Usuario  @relation(fields: [criadoPorId], references: [id])
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  @@index([produtoId])
}
